# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Plugin runtime (never committed)
/tmp/tp-*

# Local overrides
*.local.md
*.local.json

# Design-gate canary working copies — never committed (plan workspace spec).
# The second pattern is the gate folder a standalone quick-plan or quick-audit
# writes beside its document.
docs/plans/*/.canary/
docs/specs/*/.canary/
